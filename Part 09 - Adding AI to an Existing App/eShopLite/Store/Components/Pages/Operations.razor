@page "/operations"
@implements IAsyncDisposable
@using Store.Ai
@inject IServiceProvider Services
@inject SearchTelemetry Telemetry

<PageTitle>Operations</PageTitle>

<h1>Operations</h1>

@if (assistant is null)
{
    <div class="alert alert-warning">
        No local model is configured. Start Foundry Local, then set
        <code>LocalModel:Endpoint</code> and <code>LocalModel:Model</code> in user secrets
        and restart the app.
    </div>
}
else
{
    <p>Summarize recent shopper searches using a model running on this machine.</p>

    <button class="btn btn-primary mb-4" @onclick="Summarize" disabled="@busy">
        Summarize @Telemetry.Recent().Count recent searches
    </button>

    @if (busy)
    {
        <div class="alert alert-secondary">
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            <span role="status">Thinking locally. Slow local models may take several minutes.</span>
            <span aria-hidden="true">
                @elapsedSeconds second@(elapsedSeconds == 1 ? "" : "s") elapsed.
            </span>
        </div>
    }
    else if (summary is not null)
    {
        <div class="alert alert-info" style="white-space: pre-wrap">@summary</div>
    }
}

@code {
    private OperationsAssistant? assistant;
    private string? summary;
    private bool busy;
    private int elapsedSeconds;
    private readonly CancellationTokenSource componentCts = new();

    protected override void OnInitialized()
    {
        assistant = Services.GetService<OperationsAssistant>();
    }

    private async Task Summarize()
    {
        if (assistant is null)
        {
            return;
        }

        busy = true;
        summary = null;
        elapsedSeconds = 0;
        using var progressCts =
            CancellationTokenSource.CreateLinkedTokenSource(componentCts.Token);
        var progressTask = UpdateElapsedAsync(progressCts.Token);

        try
        {
            summary = await assistant.SummarizeAsync(componentCts.Token);
        }
        catch (OperationCanceledException) when (componentCts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            summary = $"The local model could not complete the summary: {ex.Message}";
        }
        finally
        {
            await progressCts.CancelAsync();
            await progressTask;
            busy = false;
        }
    }

    private async Task UpdateElapsedAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                elapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await componentCts.CancelAsync();
        componentCts.Dispose();
    }
}
